generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeaveStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  STUDENT
  DEPARTMENT_HEAD
  DEAN_STUDENT_AFFAIRS
  FACULTY
}

enum LeaveRequestType {
  MEDICAL
  ON_DUTY
  GENERAL
  HOSTEL
  OTHER
  ANNUAL
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EmployeeCategory {
  STUDENT
  TEACHING_STAFF
  NON_TEACHING_STAFF
}

enum LeaveCategory {
  ANNUAL
  MEDICAL
  CASUAL
  EMERGENCY
  SPECIAL
}

model LeaveType {
  id                  Int                        @id @default(autoincrement())
  code                String                     @unique
  name                String
  leaveGroup          String                     @default("") @map("leave_group")
  paymentType         String?                    @map("payment_type")
  category            LeaveCategory?
  categoryMasterId    Int?                       @map("category_master_id")
  categoryMaster      LeaveCategoryMaster?       @relation(fields: [categoryMasterId], references: [id], onDelete: SetNull)
  daysAllowed         Int                        @map("days_allowed")
  description         String                     @default("")
  status              String                     @default("ACTIVE")
  applicableTo        EmployeeCategory[]         @default([STUDENT])
  isUsed              Boolean                    @default(false) @map("is_used")
  carryForward        Boolean                    @default(false) @map("carry_forward")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employeeEligibility EmployeeLeaveEligibility[]
  groupItems          LeaveGroupItem[]
  leaveCredits        LeaveCredit[]
  leaveApplications   EmployeeLeaveApplication[]
  usageRecords        EmployeeLeaveUsage[]
  cycleBalances       EmployeeCycleBalance[]

  @@map("leave_types")
}

model LeaveEligibility {
  id               Int         @id @default(autoincrement())
  eligibilityName  String      @map("eligibility_name")
  description      String      @default("")
  employeeType     String      @map("employee_type")
  employmentType   String      @map("employment_type")
  managementStream String      @default("") @map("management_stream")
  leaveGroup       String      @map("leave_group")
  status           LeaveStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("leave_eligibilities")
}

model Employee {
  employeeId                String                     @id @map("employee_id")
  name                      String
  stream                    String
  department                String
  status                    String                     @default("Approved")
  gender                    String
  designation               String?
  religion                  String?
  mobileNumber              String?                    @map("mobile_number")
  workEmail                 String?                    @map("work_email")
  leaveRecords              EmployeeLeaveEligibility[]
  leaveUsage                EmployeeLeaveUsage[]
  maternityLeave            MaternityLeave?
  paternityLeaves           PaternityLeave[]
  leaveBalances             EmployeeLeaveBalance[]
  blockedLeaves             BlockedLeave[]
  leaveCredits              LeaveCredit[]
  notifications             EmployeeNotification[]
  employeeLeaveApplications EmployeeLeaveApplication[]
  approverSettings          EmployeeApprover?
  employeeType              String?                    @default("Teaching") @map("employee_type")
  employmentType            String?                    @default("Permanent") @map("employment_type")
  cycleBalances             EmployeeCycleBalance[]

  @@map("employees")
}

