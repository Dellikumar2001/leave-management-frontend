generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeaveStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  STUDENT
  DEPARTMENT_HEAD
  DEAN_STUDENT_AFFAIRS
  FACULTY
}

enum LeaveRequestType {
  MEDICAL
  ON_DUTY
  GENERAL
  HOSTEL
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeCategory {
  STUDENT
  TEACHING_STAFF
  NON_TEACHING_STAFF
}

enum LeaveCategory {
  ANNUAL
  MEDICAL
  CASUAL
  EMERGENCY
  SPECIAL
}

model LeaveType {
  id                  Int                        @id @default(autoincrement())
  code                String                     @unique
  name                String
  leaveGroup          String                     @default("") @map("leave_group")
  paymentType         String?                    @map("payment_type")
  daysAllowed         Int                        @default(1) @map("days_allowed")
  description         String                     @default("")
  status              String                     @default("ACTIVE")
  isUsed              Boolean                    @default(false) @map("is_used")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employeeEligibility EmployeeLeaveEligibility[]
  groupItems          LeaveGroupItem[]

  @@map("leave_types")
}

model Employee {
  employeeId      String                     @id @map("employee_id")
  name            String
  stream          String
  department      String
  status          String                     @default("Approved")
  leaveRecords    EmployeeLeaveEligibility[]
  paternityLeaves PaternityLeave[]
  maternityLeaves MaternityLeave[]

  @@map("employees")
}

model EmployeeLeaveEligibility {
  employeeId   String    @map("employee_id")
  leaveTypeId  Int       @map("leave_type_id")
  isEligible   Boolean   @default(true) @map("is_eligible")
  daysAllowed  Int       @default(0) @map("days_allowed")
  leaveBalance Int       @default(0) @map("leave_balance")
  joiningDate  DateTime  @default(dbgenerated("(DATE '2026-01-01' + FLOOR(RANDOM() * 364)::INTEGER)")) @map("joining_date") @db.Date
  employee     Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@id([employeeId, leaveTypeId])
  @@index([leaveTypeId])
  @@map("employee_leave_eligibilities")
}

model LeaveCategoryMaster {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  isPaid      Boolean      @default(true)
  description String?
  status      LeaveStatus  @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  leaveGroups LeaveGroup[]

  @@map("LeaveCategoryMaster")
}

model LeaveGroup {
  id            Int                  @id @default(autoincrement())
  code          String               @unique
  name          String
  description   String?
  effectiveFrom DateTime
  status        LeaveStatus          @default(ACTIVE)
  categoryId    Int?
  category      LeaveCategoryMaster? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items         LeaveGroupItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model LeaveGroupItem {
  id           Int        @id @default(autoincrement())
  leaveGroupId Int
  leaveGroup   LeaveGroup @relation(fields: [leaveGroupId], references: [id], onDelete: Cascade)
  leaveTypeId  Int
  leaveType    LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@unique([leaveGroupId, leaveTypeId])
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  headId    Int?
  head      User?     @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  users     User[]    @relation("DepartmentMembers")
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id                    Int                        @id @default(autoincrement())
  email                 String?                    @unique
  firstName             String?
  lastName              String?
  name                  String?
  role                  UserRole                   @default(STUDENT)
  isActive              Boolean                    @default(true)
  departmentId          Int?
  department            Department?                @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headedDepartments     Department[]               @relation("DepartmentHead")
  student               Student?
  reviewedLeaveRequests StudentLeaveRequest[]      @relation("LeaveRequestReviewer")
  notifications         Notification[]
  extensionPosition     ExtensionActivityPosition?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
}

model Student {
  id            Int                   @id @default(autoincrement())
  userId        Int                   @unique
  departmentId  Int?
  studentCode   String?
  firstName     String?
  lastName      String?
  name          String?
  stream        String?
  year          Int?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaveRequests StudentLeaveRequest[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model StudentLeaveRequest {
  id           Int                @id @default(autoincrement())
  studentId    Int
  type         LeaveRequestType
  startDate    DateTime
  endDate      DateTime
  reason       String
  documentUrl  String?
  status       LeaveRequestStatus @default(PENDING)
  reviewerRole String?
  remarks      String?
  reviewedBy   Int?
  paymentType  String?
  appliedAt    DateTime           @default(now())
  reviewedAt   DateTime?
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer     User?              @relation("LeaveRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   String
  type      String
  priority  String   @default("normal")
  actionUrl String?
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExtensionActivityPosition {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  position  String   @default("EXTENSION_ACTIVITY_HEAD")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Holiday {
  id              Int      @id @default(autoincrement())
  date            DateTime @db.Date
  name            String
  type            String
  description     String   @default("")
  status          String   @default("active")
  repeatEveryYear Boolean  @default(false) @map("repeat_every_year")
  isHoliday       Boolean  @default(true) @map("is_holiday")

  @@index([date])
  @@map("holiday_calendar")
}

model PaternityLeave {
  id           Int       @id @default(autoincrement())
  employeeId   String    @map("employee_id")
  employeeName String    @map("employee_name")
  noOfDays     Int       @default(5) @map("no_of_days")
  remarks      String?   @map("remarks")
  status       String    @default("Active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  employee     Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId])
  @@map("paternity_leaves")
}

model MaternityLeave {
  id           Int       @id @default(autoincrement())
  employeeId   String    @map("employee_id")
  employeeName String    @map("employee_name")
  noOfDays     Int       @default(180) @map("no_of_days")
  remarks      String?   @map("remarks")
  status       String    @default("Active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  employee     Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId])
  @@map("maternity_leaves")
}
