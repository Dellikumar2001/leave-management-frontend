model EmployeeLeaveEligibility {
  employeeId   String    @map("employee_id")
  leaveTypeId  Int       @map("leave_type_id")
  isEligible   Boolean   @default(true) @map("is_eligible")
  daysAllowed  Int       @default(0) @map("days_allowed")
  leaveBalance Int       @default(0) @map("leave_balance")
  creditedDays Int       @default(0) @map("credited_days")
  joiningDate  DateTime  @default(dbgenerated("('2026-01-01'::date + (floor((random() * (364)::double precision)))::integer)")) @map("joining_date") @db.Date
  bf           Int       @default(0) @map("bf")
  earned       Int       @default(0) @map("earned")
  gender       String    @default("") @map("gender")
  employee     Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@id([employeeId, leaveTypeId])
  @@index([leaveTypeId])
  @@map("employee_leave_eligibilities")
}

model MaternityLeave {
  id           Int       @id @default(autoincrement())
  employeeId   String    @unique @map("employee_id")
  employeeName String    @map("employee_name")
  noOfDays     Int       @default(180) @map("no_of_days")
  remarks      String?   @map("remarks")
  status       String    @default("Active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  employee     Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId])
  @@map("maternity_leaves")
}

model EmployeeLeaveBalance {
  employeeId String        @map("employee_id")
  category   LeaveCategory
  balance    Int           @default(0)
  employee   Employee      @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@id([employeeId, category])
  @@map("employee_leave_balances")
}

model BlockedLeave {
  id         Int      @id @default(autoincrement())
  employeeId String   @map("employee_id")
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("blocked_leaves")
}

model LeaveCredit {
  id          Int           @id @default(autoincrement())
  employeeId  String        @map("employee_id")
  category    LeaveCategory
  days        Int
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  version     Int           @default(1)
  leaveTypeId Int?          @map("leave_type_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")
  employee    Employee      @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType   LeaveType?    @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@index([employeeId, category, createdAt])
  @@map("leave_credits")
}

model EmployeeNotification {
  id         Int      @id @default(autoincrement())
  employeeId String   @map("employee_id")
  title      String
  content    String
  type       String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId, isRead, createdAt])
  @@map("employee_notifications")
}

model LeaveCategoryMaster {
  id          Int                  @id @default(autoincrement())
  code        String               @unique
  name        String
  isPaid      Boolean              @default(true)
  description String?
  status      LeaveStatus          @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  leaveGroups LeaveGroup[]
  groupLinks  LeaveGroupCategory[]
  leaveTypes  LeaveType[]

  @@map("LeaveCategoryMaster")
}

model LeaveGroup {
  id            Int                  @id @default(autoincrement())
  code          String               @unique
  name          String
  description   String?
  effectiveFrom DateTime
  status        LeaveStatus          @default(ACTIVE)
  categoryId    Int?
  category      LeaveCategoryMaster? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categories    LeaveGroupCategory[]
  items         LeaveGroupItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model LeaveGroupCategory {
  leaveGroupId Int
  categoryId   Int
  leaveGroup   LeaveGroup          @relation(fields: [leaveGroupId], references: [id], onDelete: Cascade)
  category     LeaveCategoryMaster @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([leaveGroupId, categoryId])
  @@index([categoryId])
}

model LeaveGroupItem {
  id           Int        @id @default(autoincrement())
  leaveGroupId Int
  leaveGroup   LeaveGroup @relation(fields: [leaveGroupId], references: [id], onDelete: Cascade)
  leaveTypeId  Int
  leaveType    LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@unique([leaveGroupId, leaveTypeId])
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  headId    Int?
  head      User?     @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  users     User[]    @relation("DepartmentMembers")
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id                    Int                        @id @default(autoincrement())
  email                 String?                    @unique
  firstName             String?
  lastName              String?
  name                  String?
  role                  UserRole                   @default(STUDENT)
  isActive              Boolean                    @default(true)
  departmentId          Int?
  department            Department?                @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headedDepartments     Department[]               @relation("DepartmentHead")
  student               Student?
  reviewedLeaveRequests StudentLeaveRequest[]      @relation("LeaveRequestReviewer")
  notifications         Notification[]
  extensionPosition     ExtensionActivityPosition?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
}

model Student {
  id            Int                   @id @default(autoincrement())
  userId        Int                   @unique
  departmentId  Int?
  studentCode   String?
  firstName     String?
  lastName      String?
  name          String?
  stream        String?
  year          Int?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaveRequests StudentLeaveRequest[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model StudentLeaveRequest {
  id           Int                @id @default(autoincrement())
  studentId    Int
  type         LeaveRequestType
  startDate    DateTime
  endDate      DateTime
  reason       String
  documentUrl  String?
  status       LeaveRequestStatus @default(PENDING)
  reviewerRole String?
  remarks      String?
  reviewedBy   Int?
  paymentType  String?
  appliedAt    DateTime           @default(now())
  reviewedAt   DateTime?
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer     User?              @relation("LeaveRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   String
  type      String
  priority  String   @default("normal")
  actionUrl String?
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExtensionActivityPosition {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  position  String   @default("EXTENSION_ACTIVITY_HEAD")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holiday {
  id              Int      @id @default(autoincrement())
  date            DateTime @db.Date
  name            String
  type            String
  description     String   @default("")
  status          String   @default("active")
  repeatEveryYear Boolean  @default(false) @map("repeat_every_year")
  isHoliday       Boolean  @default(true) @map("is_holiday")

  @@index([date])
  @@map("holiday_calendar")
}

model PaternityLeave {
  id           Int       @id @default(autoincrement())
  employeeId   String    @map("employee_id")
  employeeName String    @map("employee_name")
  noOfDays     Int       @default(5) @map("no_of_days")
  remarks      String?   @map("remarks")
  status       String    @default("Active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  employee     Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId])
  @@map("paternity_leaves")
}

model EmployeeLeaveApplication {
  id          Int       @id @default(autoincrement())
  employeeId  String    @map("employee_id")
  leaveTypeId Int       @map("leave_type_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  daysCount   Int       @default(1) @map("days_count")
  reason      String
  status      String    @default("Pending")
  currentApprovalLevel Int @default(1) @map("current_approval_level")
  appliedAt   DateTime  @default(now()) @map("applied_at")
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  remarks     String?
  employee    Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvals   EmployeeLeaveApproval[]

  @@index([employeeId, startDate, endDate])
  @@index([status, currentApprovalLevel])
  @@map("employee_leave_applications")
}

model EmployeeLeaveUsage {
  id         Int             @id @default(autoincrement())
  employeeId String          @map("employee_id")
  leaveTypeId Int            @map("leave_type_id")
  startDate  DateTime        @map("start_date") @db.Date
  endDate    DateTime        @map("end_date") @db.Date
  daysCount  Int             @default(1) @map("days_count")
  type       LeaveRequestType
  status     String          @default("APPROVED")
  reason     String
  appliedAt  DateTime        @default(now()) @map("applied_at")
  reviewedBy String?         @map("reviewed_by")
  reviewedAt DateTime?       @map("reviewed_at")
  employee   Employee        @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType  LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, startDate])
  @@index([employeeId, startDate, endDate])
  @@map("employee_leave_usage")
model EmployeeLeaveApproval {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  level         Int
  approver      String
  action        String
  isBackup      Boolean   @default(false) @map("is_backup")
  remarks       String?
  actionAt      DateTime  @default(now()) @map("action_at")
  application   EmployeeLeaveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, level])
  @@map("employee_leave_approvals")
}

model EmployeeApprover {
  id                 Int       @id @default(autoincrement())
  employeeId         String    @unique @map("employee_id")
  firstLevelApprover      String?   @map("first_level_approver")
  secondLevelApprover     String?   @map("second_level_approver")
  finalLevelApprover      String?   @map("final_level_approver")
  backupOfficer           String?   @map("backup_officer")
  finalLevelBackupOfficer String?   @map("final_level_backup_officer")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")
  employee           Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_approvers")
}

model LeaveYearEndProcess {
  id                   Int                  @id @default(autoincrement())
  currentCycle         String               @map("current_cycle")
  nextCycle            String               @map("next_cycle")
  processedBy          String               @default("Administrator") @map("processed_by")
  processedAt          DateTime             @default(now()) @map("processed_at")
  totalEmployees       Int                  @default(0) @map("total_employees")
  totalBalancesCreated Int                  @default(0) @map("total_balances_created")
  totalCarriedForward  Int                  @default(0) @map("total_carried_forward")
  totalReset           Int                  @default(0) @map("total_reset")
  totalSkipped         Int                  @default(0) @map("total_skipped")
  totalFailed          Int                  @default(0) @map("total_failed")
  status               String               @default("COMPLETED")
  records              LeaveYearEndRecord[]

  @@index([currentCycle, nextCycle])
  @@map("leave_year_end_processes")
}

model LeaveYearEndRecord {
  id                     Int                 @id @default(autoincrement())
  processId              Int                 @map("process_id")
  employeeId             String              @map("employee_id")
  employeeName           String              @map("employee_name")
  department             String              @default("")
  stream                 String              @default("")
  leaveTypeId            Int                 @map("leave_type_id")
  leaveTypeCode          String              @map("leave_type_code")
  leaveTypeName          String              @map("leave_type_name")
  currentCycle           String              @map("current_cycle")
  nextCycle              String              @map("next_cycle")
  entitlement            Int                 @default(0)
  leaveUsed              Int                 @default(0) @map("leave_used")
  availableBalance       Int                 @default(0) @map("available_balance")
  rule                   String              @default("RESET")
  maxCarryForward        Int?                @map("max_carry_forward")
  carriedForwardDays     Int                 @default(0) @map("carried_forward_days")
  proposedOpeningBalance Int                 @default(0) @map("proposed_opening_balance")
  status                 String              @default("SUCCESS")
  reason                 String?
  createdAt              DateTime            @default(now()) @map("created_at")
  process                LeaveYearEndProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([processId, employeeId, leaveTypeId])
  @@index([employeeId, leaveTypeId, nextCycle])
  @@index([processId, employeeId, nextCycle])
  @@map("leave_year_end_records")
}

model EmployeeCycleBalance {
  id             Int       @id @default(autoincrement())
  employeeId     String    @map("employee_id")
  leaveTypeId    Int       @map("leave_type_id")
  cycle          String
  openingBalance Int       @default(0) @map("opening_balance")
  carriedForward Int       @default(0) @map("carried_forward")
  entitlement    Int       @default(0)
  currentBalance Int       @default(0) @map("current_balance")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  employee       Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, cycle])
  @@index([cycle, employeeId])
  @@map("employee_cycle_balances")
}

