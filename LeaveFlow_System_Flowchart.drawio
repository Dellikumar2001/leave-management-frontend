              <mxPoint x="1210" y="350" />
              <mxPoint x="1210" y="685" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Final Approval Deducts Balance in DB -->
        <mxCell id="edge-app-deduct" value="Deducts Balance" edge="1" parent="1" source="wf-approvefinal" target="db-elig" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=2;dashed=1;fontColor=#4ade80;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1360" y="1320" />
              <mxPoint x="2040" y="1320" />
              <mxPoint x="2040" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Final Approval / Rejection Creates Notification -->
        <mxCell id="edge-app-notify" value="Creates Notification" edge="1" parent="1" source="wf-approvefinal" target="db-notifications" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60a5fa;strokeWidth=1.5;dashed=1;fontColor=#93c5fd;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
