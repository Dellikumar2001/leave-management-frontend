        <!-- Database feeds Reports -->
        <mxCell id="edge-db-reports" value="Aggregates Data" edge="1" parent="1" source="db-apps" target="rep-indiv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c084fc;strokeWidth=1.5;dashed=1;fontColor=#d8b4fe;">
