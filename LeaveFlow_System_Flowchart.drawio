        <!-- ========================================== -->
        <!-- CONNECTING EDGES & WORKFLOW ARROWS        -->
        <!-- ========================================== -->

        <!-- Employee applies -> Submit -->
        <mxCell id="edge-emp-submit" edge="1" parent="1" source="actor-employee" target="wf-submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Submit -> Check Blocked Leaves -->
        <mxCell id="edge-sub-chkblock" edge="1" parent="1" source="wf-submit" target="wf-checkblock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60a5fa;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Blocked? YES -> 409 Reject -->
        <mxCell id="edge-chk-yes" value="YES (Blocked)" edge="1" parent="1" source="wf-checkblock" target="wf-blockreject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#f87171;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Blocked? NO -> Init Queue -->
        <mxCell id="edge-chk-no" value="NO (Clear)" edge="1" parent="1" source="wf-checkblock" target="wf-initqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=2;fontColor=#4ade80;fontStyle=1;">
