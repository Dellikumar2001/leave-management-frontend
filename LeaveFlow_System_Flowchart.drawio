        <mxCell id="lane-db" value="6. DATA PERSISTENCE (POSTGRESQL)" style="swimlane;html=1;startSize=36;rounded=1;arcSize=6;fillColor=#1e293b;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=13;fontColor=#ffffff;align=center;horizontal=1;" vertex="1" parent="1">
