              <mxPoint x="1465" y="315" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Init Queue -> Level 1 Approver Decision -->
        <mxCell id="edge-queue-l1" edge="1" parent="1" source="wf-initqueue" target="wf-level1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60a5fa;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 1 -> Decision Rhombus -->
        <mxCell id="edge-l1-dec" edge="1" parent="1" source="wf-level1" target="wf-dec1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbbf24;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 1 Decision -> Rejected -->
        <mxCell id="edge-dec1-rej" value="REJECT" edge="1" parent="1" source="wf-dec1" target="wf-rejectfinal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#f87171;fontStyle=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1650" y="725" />
              <mxPoint x="1650" y="1230" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Level 1 Decision -> Approve -> Level 2 -->
        <mxCell id="edge-dec1-app" value="APPROVE (L1 done)" edge="1" parent="1" source="wf-dec1" target="wf-level2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=2;fontColor=#4ade80;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 2 -> Decision Rhombus -->
        <mxCell id="edge-l2-dec" edge="1" parent="1" source="wf-level2" target="wf-dec2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbbf24;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 2 Decision -> Rejected -->
        <mxCell id="edge-dec2-rej" value="REJECT" edge="1" parent="1" source="wf-dec2" target="wf-rejectfinal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#f87171;fontStyle=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1630" y="930" />
              <mxPoint x="1630" y="1230" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Level 2 Decision -> Approve -> Level 3 Final -->
        <mxCell id="edge-dec2-app" value="APPROVE (L2 done)" edge="1" parent="1" source="wf-dec2" target="wf-level3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=2;fontColor=#4ade80;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 3 -> Decision Rhombus -->
        <mxCell id="edge-l3-dec" edge="1" parent="1" source="wf-level3" target="wf-dec3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbbf24;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 3 Decision -> Rejected -->
        <mxCell id="edge-dec3-rej" value="REJECT" edge="1" parent="1" source="wf-dec3" target="wf-rejectfinal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#f87171;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 3 Decision -> Approved Final -->
        <mxCell id="edge-dec3-app" value="FINAL APPROVE" edge="1" parent="1" source="wf-dec3" target="wf-approvefinal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=2;fontColor=#4ade80;fontStyle=1;">
