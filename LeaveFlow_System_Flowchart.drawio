        <mxCell id="db-credits" value="&lt;b&gt;leave_credits&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;employee_id, category, days, start_date, end_date, leave_type_id&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#334155;strokeColor=#94a3b8;fontColor=#f8fafc;fontFamily=Helvetica;" vertex="1" parent="lane-db">
          <mxGeometry x="20" y="605" width="240" height="70" as="geometry" />
