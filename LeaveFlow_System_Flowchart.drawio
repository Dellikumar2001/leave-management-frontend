        <mxCell id="db-apps" value="&lt;b&gt;employee_leave_applications&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;id, employee_id, leave_type_id, dates, days_count, status, level&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#334155;strokeColor=#94a3b8;fontColor=#f8fafc;fontFamily=Helvetica;" vertex="1" parent="lane-db">
